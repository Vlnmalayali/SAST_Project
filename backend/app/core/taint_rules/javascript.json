{
  "sources": [
    "req.query",
    "req.body",
    "req.params",
    "req.headers",
    "req.cookies",
    "request.query",
    "request.body",
    "request.params",
    "location.search",
    "window.location.search",
    "document.cookie",
    "process.argv",
    "process.env"
